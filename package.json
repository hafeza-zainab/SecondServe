{
  "name": "secondserve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "start:render": "prisma db push && (npm run seed || echo 'seed failed, starting anyway') && next start",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "gen-data": "tsx scripts/generate-synthetic.ts",
    "train": "tsx scripts/train.ts",
    "test": "tsx --test tests/time.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
